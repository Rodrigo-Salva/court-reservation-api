# Genera un valor de al menos 32 bytes: openssl rand -base64 32
JWT_SECRET=replace_with_a_base64_secret_of_at_least_32_bytes

# Solo para ejecutar con SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/courtdb
DB_USERNAME=court_user
DB_PASSWORD=replace_with_a_strong_password
CORS_ALLOWED_ORIGINS=https://app.example.com
